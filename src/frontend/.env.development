# 本地源码开发（client 端 vite 从 src/frontend/ 根目录加载 env）
#VITE_DEV_API_TARGET=http://127.0.0.1:7860
#VITE_DEV_MINIO_TARGET=http://127.0.0.1:7860
VITE_PLATFORM_ORIGIN=http://127.0.0.1:3001

#部署服务器
VITE_DEV_API_TARGET=http://127.0.0.1:7860
# 业务对象存储代理目标。其 host:port 必须与后端 config.yaml 的
# object_storage.minio.sharepoint 完全一致：预签名 URL 用 SigV4 签了 Host 头，
# 代理转发时若 Host 不同则全部 403（SignatureDoesNotMatch）。
# 注意 docker-compose 里的 127.0.0.1:9100 是 milvus 专用 MinIO，不是业务对象存储，别用。
VITE_DEV_MINIO_TARGET=http://172.19.70.108:9000/
# 本地存储模式（config.yaml object_storage.type=local）时改用下行；用 MinIO 时保持上面的 172.19.70.108:9000
#VITE_DEV_MINIO_TARGET=http://127.0.0.1:7860
VITE_PLATFORM_PREVIEW_TARGET=http://127.0.0.1:3001
