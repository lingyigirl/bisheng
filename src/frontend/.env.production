# 生产构建 + vite preview 静态服务（172.19.70.141 本机；client vite envDir=../ 从此目录加载）
# preview 继承 server.proxy / server.https（见 client/vite.config.ts）
VITE_DEV_API_TARGET=http://172.19.70.189:7860
# 预签名 URL 的签名 Host = 后端 sharepoint（backend.env BS_MINIO_SHAREPOINT），代理 target 必须一致
VITE_DEV_MINIO_TARGET=http://172.19.70.189:9100
# 平台管理端 origin：定义 client→平台 的跳转目标（getPlatformAdminPanelUrl）。
# 双端口部署（client :4001 / platform :3001）必须显式写死；改回同源单入口部署时
# 置空，此时回落 location.origin + BISHENG_HOST（直连 :4001 时 /admin、/login
# 由 client 反代回平台，见 client/vite.config.ts）。
VITE_PLATFORM_ORIGIN=http://172.19.70.189:3001
# preview 继承 server.https，沿用 dev 证书
VITE_DEV_HTTPS=false
