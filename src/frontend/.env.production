# 生产构建 + vite preview 静态服务（172.19.70.141 本机；client vite envDir=../ 从此目录加载）
# preview 继承 server.proxy / server.https（见 client/vite.config.ts）
VITE_DEV_API_TARGET=http://127.0.0.1:7860
# 预签名 URL 的签名 Host = 后端 sharepoint（backend.env BS_MINIO_SHAREPOINT），代理 target 必须一致
VITE_DEV_MINIO_TARGET=http://172.19.70.141:9100
# 平台管理端 origin：同源化（2026-09-07）——留空 = 跟随浏览器当前 origin
# （getPlatformAdminPanelUrl 回落 location.origin + BISHENG_HOST）。直连 :4001
# 时 /admin、/login 由 client preview 反代回平台（见 client/vite.config.ts）。
VITE_PLATFORM_ORIGIN=
# preview 继承 server.https，沿用 dev 证书
VITE_DEV_HTTPS=true
